{
  "$schema": "https://raw.githubusercontent.com/firebase/firebase-tools/master/schema/firebase-config.json",
  "hosting": {
    "site": "apso-vn",
    "public": "hosting-public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/apso.apk",
        "destination": "https://github.com/khanhnganpc25-cell/apso/releases/download/v2.1.1/APSO-Quan-Ly-Dan-Cu-So.apk",
        "type": 302
      },
      {
        "source": "/APSO-Quan-Ly-Dan-Cu-So.apk",
        "destination": "https://github.com/khanhnganpc25-cell/apso/releases/download/v2.1.1/APSO-Quan-Ly-Dan-Cu-So.apk",
        "type": 302
      },
      {
        "source": "/download/apso.apk",
        "destination": "https://github.com/khanhnganpc25-cell/apso/releases/download/v2.1.1/APSO-Quan-Ly-Dan-Cu-So.apk",
        "type": 302
      }
    ],
    "headers": [
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          { "key": "Content-Type", "value": "application/json; charset=utf-8" },
          { "key": "Cache-Control", "value": "public, max-age=300" }
        ]
      },
      {
        "source": "/_next/static/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/admin-reset-password",
        "function": {
          "functionId": "adminResetPassword",
          "region": "us-central1"
        }
      },
      {
        "source": "/download",
        "destination": "/download/index.html"
      },
      {
        "source": "/download/**",
        "destination": "/download/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ]
}
